# ==============================================================================
# Git Ignore Rules - Image Encryptor (Zero-Knowledge Web Application)
# ==============================================================================

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets (NEVER commit secrets!)
.env
.env.local
.env.*.local
.env.production
.env.staging

# Allow example environment templates
!.env.example
!frontend/.env.example
!backend/.env.example

# Local databases
*.db
*.sqlite
*.sqlite3
users.db

# Node.js & Frontend dependencies & build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
.vite/
frontend/.vite/

# NPM / Yarn / PNPM logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files, caches, and test artifacts
*.tmp
*.temp
*.log
.cache/
.pytest_cache/
.coverage
htmlcov/
*.secimg
*.encrypted
*.decrypted.*

# OS and Editor specific
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.swo

# Backup & scratch directories
_backup*/
backup*/
scratch/

